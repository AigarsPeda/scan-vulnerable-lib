{
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ESNext"
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*",
    "src/shared/**/*"
  ]
}
